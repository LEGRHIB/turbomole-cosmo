# turbomole-cosmo .gitignore
# Layout: molecules/<molecule>/<protocol>/<generated-files>
# All TURBOMOLE / SLURM / xtb / COSMOtherm outputs are gitignored.

# === Generated TURBOMOLE files (in any molecule's protocol subdir) ===
molecules/**/coord
molecules/**/control
molecules/**/basis
molecules/**/auxbasis
molecules/**/mos
molecules/**/mos.bak
molecules/**/alpha
molecules/**/beta
molecules/**/energy
molecules/**/statistics
molecules/**/gradient
molecules/**/GEO_OPT_CONVERGED
molecules/**/job.last
molecules/**/job.start
molecules/**/logs/

# === COSMO / CCF / job output / errors ===
molecules/**/*.cosmo
molecules/**/*.ccf
molecules/**/*.out
molecules/**/*.err
molecules/**/*.stamp

# === SLURM job scripts (regenerated by submit_cosmo.sh / prep_cosmo.sh) ===
molecules/**/*.slurm

# === Per-molecule outputs / artifacts ===
molecules/**/cosmotherm/
molecules/**/GFN-xTB-OPT/

# === Geometry inputs and backups (regenerated by prepare_molecule.py + xtb_preopt) ===
molecules/**/*.xyz
molecules/**/*_pre_xtb.xyz
molecules/**/*.bak

# === Keep reference/ tracked (regression-test ground truth) ===
!molecules/*/reference/
!molecules/*/*/reference/

# === Python ===
__pycache__/
*.pyc
*.pyo

# === OS / editor junk ===
.DS_Store
Thumbs.db
*~
*.swp

# === Audit reports (local-only; agent writes them per-run) ===
.claude/audit-reports/

# Audit additions 2026-05-19
.claude/
docs/*.pdf
**/_archive-*/
**/propka/
