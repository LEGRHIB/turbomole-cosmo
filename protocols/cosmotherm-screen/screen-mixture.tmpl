# COSMOtherm input template — solubility in a binary solvent mixture.
# Placeholders (substituted by scripts/cosmotherm_screen.sh):
#   __CT_PARAM_PATH__   directory containing BP_TZVPD_FINE_25.ctd
#   __CT_LICENSE_DIR__  directory containing license.txt
#   __FDIR__            directory containing reference solvent .cosmo files
#   __MOLECULE__        molecule label
#   __MOL_COSMO__       absolute path to the molecule's .cosmo file
#   __MIX_LABEL__       human-readable mixture label (for the comment line)
#   __SOLVENT1__        COSMObase basename of solvent 1 (e.g. h2o)
#   __SOLVENT2__        COSMObase basename of solvent 2 (e.g. ethanol)
#   __X_SOLVENT1__      mole fraction of solvent 1 in the binary mixture (0..1)
#   __X_SOLVENT2__      mole fraction of solvent 2 in the binary mixture (0..1)
#
# Reference: COSMOtherm 2025 Manual section 2.3.4 (Solubility, finite mixture);
# example MIXTURE-XCQ for xs/x syntax.
#
# Compounds: 1 = solute, 2 = solvent1, 3 = solvent2.
# xs sets the solvent composition; solute mole fraction is determined by the
# automatic solubility computation.

ctd=BP_TZVPD_FINE_25.ctd CDIR=__CT_PARAM_PATH__ LDIR=__CT_LICENSE_DIR__
FDIR=__FDIR__ UNIT=SI nocompw wtln
!! Solubility of __MOLECULE__ in mixture __MIX_LABEL__
f="__MOL_COSMO__" autoc comp=__MOLECULE__
f="__SOLVENT1___c0.cosmo" autoc
f="__SOLVENT2___c0.cosmo" autoc
tc=25.0 solub iterative force_qspr xs={0.0 __X_SOLVENT1__ __X_SOLVENT2__}
xsolout_x_log10 wsolout_gg lsolout_moll_log10 lsolout_gl
