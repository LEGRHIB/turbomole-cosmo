# COSMOtherm input template — pure-solvent solubility screening.
# Placeholders (substituted by scripts/cosmotherm_screen.sh):
#   __CT_PARAM_PATH__   directory containing BP_TZVPD_FINE_25.ctd
#   __CT_LICENSE_DIR__  directory containing license.txt
#   __FDIR__            directory containing reference solvent .cosmo files
#   __MOLECULE__        molecule label (used as comp= name in tables)
#   __MOL_COSMO__       absolute path to the molecule's .cosmo file
#   __SOLVENTS_LIST__   absolute path to f_batch list (one solvent basename per line)
#
# Reference: COSMOtherm 2025 Manual section 2.3.4 (Solubility), example BATCH-LIST-TXT.

ctd=BP_TZVPD_FINE_25.ctd CDIR=__CT_PARAM_PATH__ LDIR=__CT_LICENSE_DIR__
FDIR=__FDIR__ UNIT=SI nocompw wtln
!! Solubility solvent screening for __MOLECULE__ across pure solvents
f="__MOL_COSMO__" autoc comp=__MOLECULE__
f="h2o_c0.cosmo" autoc
f_batch=__SOLVENTS_LIST__
tc=25.0 solub screening solute=1 pure=3 force_qspr iterative
xsolout_x_log10 wsolout_gg lsolout_moll_log10 lsolout_gl
