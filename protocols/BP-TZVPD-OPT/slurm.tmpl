#!/bin/bash -l
#SBATCH --clusters=__CLUSTER__
#SBATCH --partition=__PARTITION__
#SBATCH --account=__ACCOUNT__
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=__CPUS__
#SBATCH --time=__TIME__
#SBATCH --mem=__MEM__
#SBATCH --job-name=__MOLECULE__-cosmo-opt
#SBATCH --output=__INDIR__/jobex-cosmo.out
#SBATCH --error=__INDIR__/jobex-cosmo.err

set -euo pipefail

INDIR=__INDIR__
WORKDIR=$VSC_SCRATCH/__MOLECULE__-jobex-$SLURM_JOB_ID
mkdir -p "$WORKDIR"
cd "$WORKDIR"

source __TURBOMOLE_ROOT__/vars
export PARA_ARCH=SMP
export TURBOMOLE_SYSNAME=__SYSNAME__
export PATH=__TURBOMOLE_ROOT__/bin/$TURBOMOLE_SYSNAME:__TURBOMOLE_ROOT__/scripts:$PATH
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# Stage inputs (auxbasis needed for RI-J)
for f in control coord basis mos auxbasis; do
  [[ -f "$INDIR/$f" ]] && cp -a "$INDIR/$f" ./
done

# Geometry optimization with RI-DFT + COSMO
# -ri     = use RI-DFT (ridft + rdgrad)
# -c 200  = max 200 optimization cycles
# -energy 7  = energy convergence 1e-7 Hartree
# -gcart  4  = gradient convergence 1e-4 Hartree/Bohr
jobex -ri -c 200 -energy 7 -gcart 4 > jobex.out 2>&1

JOBEX_EXIT=$?

echo "jobex exit code: $JOBEX_EXIT"
echo "Optimization converged:" $(grep -c 'CONVERGENCE' GEO_OPT_CONVERGED 2>/dev/null || echo "NO")

# Copy all outputs back to input directory
cp -a jobex.out energy gradient "$INDIR"/ 2>/dev/null || true
cp -a coord control "$INDIR"/ 2>/dev/null || true
cp -a *.cosmo *.ccf "$INDIR"/ 2>/dev/null || true
cp -a GEO_OPT_CONVERGED "$INDIR"/ 2>/dev/null || true
# Also save the final ridft output
cp -a ridft.out "$INDIR"/ 2>/dev/null || true

echo "Files copied back to $INDIR"
ls -lah
